<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for WebView ladowania https://invoicer.kasaflow.cloud -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Kamera fallback dla scanowania jezeli laser Sunmi nie zadziala -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Sunmi-specific permissions (Printer + Scanner) -->
    <uses-permission android:name="com.sunmi.permission.PRINTER" tools:ignore="MissingPermission" />
    <uses-permission android:name="com.sunmi.scanner.permission.READ_DATA" tools:ignore="MissingPermission" />

    <!-- Feature: kamera opcjonalna (nie blokuje instalacji na urzadzeniach bez kamery) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KsefInvoicerSunmi"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- BroadcastReceiver dla Sunmi scanner laser button.
             Sunmi V2s emituje intent po naciśnięciu fizycznego triggera. -->
        <receiver
            android:name=".scanner.SunmiScannerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.sunmi.scanner.ACTION_DATA_CODE_RECEIVED" />
                <action android:name="com.summi.scanner.ACTION_DATA_CODE_RECEIVED" />
                <action android:name="nlscan.action.SCANNER_RESULT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
